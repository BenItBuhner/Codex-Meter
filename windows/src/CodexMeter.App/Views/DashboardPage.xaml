<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CodexMeter.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodexMeter.App.Controls"
    Background="Transparent">
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1180" Padding="36,28,36,36" Spacing="14">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HeaderIconHost" Width="40" Height="40" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="DashboardTitle" />
                        <Border x:Name="PlanBadge" Style="{StaticResource PlanBadgeStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="PlanText" Style="{StaticResource PlanBadgeTextStyle}" AutomationProperties.AutomationId="PlanBadge" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionSecondaryTextStyle}" AutomationProperties.AutomationId="DashboardSubtitle" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="RefreshingRing" Width="20" Height="20" IsActive="False" />
                    <Button x:Name="RefreshButton" Click="OnRefreshClick" AutomationProperties.AutomationId="RefreshButton"
                            ToolTipService.ToolTip="Refresh (F5)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="StatusBar" IsClosable="True" IsOpen="False" AutomationProperties.AutomationId="StatusBar" />

            <!-- Signed out: what this provider shows and how to connect it. -->
            <Border x:Name="SignedOutPanel" Style="{StaticResource CardBorderStyle}" Padding="36" Visibility="Collapsed">
                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="460">
                    <Border x:Name="SignedOutIconHost" Width="56" Height="56" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SignedOutTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="SignedOutBody" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    <Button x:Name="SignInButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnSignInClick"
                            AutomationProperties.AutomationId="SignInButton" Padding="20,6,20,7" />
                    <TextBlock x:Name="SignInHint" Style="{StaticResource CaptionSecondaryTextStyle}" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <controls:CardPanel x:Name="MeterCards" MinColumnWidth="330" Spacing="12" />

            <TextBlock x:Name="ExtrasHeader" Text="Extras" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,10,0,0" Visibility="Collapsed" />
            <controls:CardPanel x:Name="ExtraCards" MinColumnWidth="330" Spacing="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
