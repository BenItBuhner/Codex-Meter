<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CodexMeter.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,24,0,6" />
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Padding="36,28,36,36" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="SettingsTitle" />

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="App theme" Description="Follow Windows, or always use light or dark.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeBox" AutomationProperties.AutomationId="ThemeBox" SelectionChanged="OnChanged" MinWidth="160">
                    <ComboBoxItem Content="Use system setting" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Window material" Description="Mica tints the window with your desktop wallpaper.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="BackdropBox" SelectionChanged="OnChanged" MinWidth="160">
                    <ComboBoxItem Content="Mica" />
                    <ComboBoxItem Content="Mica Alt" />
                    <ComboBoxItem Content="Acrylic" />
                </ComboBox>
            </toolkit:SettingsCard>

            <TextBlock Text="Providers" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsExpander x:Name="ProvidersExpander" Header="Providers in the sidebar"
                                      Description="Choose which services get a page and the order they appear in." IsExpanded="True"
                                      AutomationProperties.AutomationId="ProvidersExpander">
                <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8FD;" /></toolkit:SettingsExpander.HeaderIcon>
            </toolkit:SettingsExpander>

            <TextBlock Text="Dashboard" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="Show usage as" Description="The number in each ring.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D2;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="DisplayBox" SelectionChanged="OnChanged" MinWidth="160" AutomationProperties.AutomationId="DisplayBox">
                    <ComboBoxItem Content="Remaining" />
                    <ComboBoxItem Content="Used" />
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Reset times" Description="How each card says when its window resets.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE823;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ResetBox" SelectionChanged="OnChanged" MinWidth="160">
                    <ComboBoxItem Content="Countdown" />
                    <ComboBoxItem Content="Date and time" />
                    <ComboBoxItem Content="Both" />
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="24-hour clock">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC92;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="ClockSwitch" Toggled="OnChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Pace estimates" Description="Warn when a window would run out before it resets at your current pace.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC4A;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="PaceSwitch" Toggled="OnChanged" />
            </toolkit:SettingsCard>

            <TextBlock Text="Updates and alerts" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="Check usage every" Description="While Codex Meter runs. Claude Code is checked at most every 30 minutes because Anthropic limits polling.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE895;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="RefreshBox" SelectionChanged="OnChanged" MinWidth="160">
                    <ComboBoxItem Content="5 minutes" />
                    <ComboBoxItem Content="15 minutes" />
                    <ComboBoxItem Content="30 minutes" />
                    <ComboBoxItem Content="1 hour" />
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Notify when a limit resets">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEA8F;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="ResetAlertSwitch" Toggled="OnChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Notify when running low" Description="When a 5-hour, weekly or monthly window drops to this much or runs out.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7BA;" /></toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="ThresholdBox" SelectionChanged="OnChanged" MinWidth="100">
                        <ComboBoxItem Content="10% left" />
                        <ComboBoxItem Content="15% left" />
                        <ComboBoxItem Content="25% left" />
                    </ComboBox>
                    <ToggleSwitch x:Name="LowAlertSwitch" Toggled="OnChanged" />
                </StackPanel>
            </toolkit:SettingsCard>

            <TextBlock Text="Windows" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="Show in the notification area" Description="A tray icon with your remaining allowance; hover for every provider.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="TraySwitch" Toggled="OnChanged" AutomationProperties.AutomationId="TraySwitch" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Keep running when the window is closed" Description="Closing hides the window; quit from the tray icon.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8BB;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="CloseToTraySwitch" Toggled="OnChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Start with Windows" Description="Opens in the notification area when you sign in to Windows.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="StartupSwitch" Toggled="OnChanged" />
            </toolkit:SettingsCard>

            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsExpander Header="Codex Meter for Windows" x:Name="AboutExpander"
                                      Description="Unofficial and open source. No analytics, no ads, no relay server: the app talks to each provider directly.">
                <toolkit:SettingsExpander.HeaderIcon><BitmapIcon UriSource="ms-appx:///Assets/AppIcon.png" ShowAsMonochrome="False" /></toolkit:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionSecondaryTextStyle}" VerticalAlignment="Center" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Your data" Description="Credentials are encrypted with Windows Data Protection for your user account. Cached usage and settings live in your local app data folder.">
                        <Button Content="Open folder" Click="OnOpenDataFolder" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Source code and releases" Description="github.com/BenItBuhner/Codex-Meter">
                        <HyperlinkButton Content="Open on GitHub" NavigateUri="https://github.com/BenItBuhner/Codex-Meter" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
