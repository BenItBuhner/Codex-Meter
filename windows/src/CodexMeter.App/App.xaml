<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CodexMeter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Cards follow the Windows 11 card recipe: layer fill, hairline stroke, 8px corners. -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="20,18,20,18" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CaptionSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CriticalTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="AccentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PlanBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,2,8,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PlanBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="DemoBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1,6,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Ring meter strokes. One path per level so colors stay correct in light and dark. -->
            <Style x:Key="RingTrackStyle" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                <Setter Property="StrokeThickness" Value="9" />
                <Setter Property="Opacity" Value="0.45" />
            </Style>
            <Style x:Key="RingNormalStyle" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="StrokeThickness" Value="9" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>
            <Style x:Key="RingCautionStyle" TargetType="Path" BasedOn="{StaticResource RingNormalStyle}">
                <Setter Property="Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="RingCriticalStyle" TargetType="Path" BasedOn="{StaticResource RingNormalStyle}">
                <Setter Property="Stroke" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="BarTrackStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Height" Value="6" />
            </Style>
            <Style x:Key="BarNormalStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Height" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="BarCautionStyle" TargetType="Border" BasedOn="{StaticResource BarNormalStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="BarCriticalStyle" TargetType="Border" BasedOn="{StaticResource BarNormalStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="ProviderGlyphStyle" TargetType="PathIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
