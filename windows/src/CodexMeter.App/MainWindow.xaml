<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexMeter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Codex Meter">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: drawn over Mica, drag region set in code. -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock x:Name="TitleText" Text="Codex Meter" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Border x:Name="DemoBadge" Style="{StaticResource DemoBadgeStyle}" Visibility="Collapsed">
                    <TextBlock Text="Demo data" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            AutomationProperties.AutomationId="MainNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AccountsItem" Content="Accounts" Tag="accounts" AutomationProperties.AutomationId="Nav_accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
