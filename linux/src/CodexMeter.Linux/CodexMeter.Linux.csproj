<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CodexMeter.Linux</RootNamespace>
    <AssemblyName>codex-meter</AssemblyName>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- The app is English-only and formats dates itself, so ICU isn't needed at runtime. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Adw-1" Version="0.8.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\windows\src\CodexMeter.Core\CodexMeter.Core.csproj" />
    <!-- The provider marks are generated once (windows/tools/gen_provider_icons.py) and shared. -->
    <Compile Include="..\..\..\windows\src\CodexMeter.App\Assets\ProviderIcons.g.cs" Link="Assets\ProviderIcons.g.cs" />
    <InternalsVisibleTo Include="CodexMeter.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app icon in a hicolor tree next to the binary, so it shows before (or without) installation. -->
    <Content Include="..\..\data\icons\**\*.png" LinkBase="icons" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
