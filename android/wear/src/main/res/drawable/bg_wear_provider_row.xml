<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/codex_pressed">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/codex_control" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/codex_blue" />
                    <corners android:radius="@dimen/wear_card_radius" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/codex_card" />
                    <corners android:radius="@dimen/wear_card_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
