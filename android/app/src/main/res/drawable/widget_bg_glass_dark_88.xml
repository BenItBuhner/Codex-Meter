<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass widget surface (dark, 88%): a see-through fill, a light sheen from the top
     and a bright rim, like iOS 26's clear glass widgets. Launchers can't blur what's behind a
     widget, so this is the frosted look without the blur. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="#A61C1C1E"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <gradient android:angle="270" android:startColor="#24FFFFFF" android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" android:centerY="0.45" android:type="linear"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <stroke android:width="1dp" android:color="#59000000"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp"/>
            <stroke android:width="1dp" android:color="#40FFFFFF"/>
        </shape>
    </item>
</layer-list>
