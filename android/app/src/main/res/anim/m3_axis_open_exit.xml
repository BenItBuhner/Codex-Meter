<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Expressive page motion (ExpressiveMotion): the page underneath holds still while the
     page above slides along the X axis and fades. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:fromAlpha="1"
    android:toAlpha="1" />
