<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Expressive dashboard: a large flexible header, cards and a floating toolbar of
     provider tabs, all Material Components views (ExpressiveDashboard fills it). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/expressive_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/expressive_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="128dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expressive_edit"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Edit dashboard"
                    app:icon="@drawable/ic_m3_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expressive_refresh"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Refresh"
                    app:icon="@drawable/ic_m3_refresh" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expressive_settings"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Settings"
                    app:icon="@drawable/ic_m3_settings" />
            </LinearLayout>

            <TextView
                android:id="@+id/expressive_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="40dp"
                android:textAppearance="?attr/textAppearanceDisplaySmallEmphasized"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/expressive_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.loadingindicator.LoadingIndicator
                android:id="@+id/expressive_loading"
                style="@style/Widget.Material3.LoadingIndicator.Contained"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:contentDescription="Refreshing"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/expressive_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
        android:id="@+id/expressive_toolbar"
        style="@style/Widget.Material3.FloatingToolbar.Vibrant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/expressive_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Providers"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>
</FrameLayout>
