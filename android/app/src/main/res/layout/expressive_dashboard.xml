<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Expressive dashboard: a large header with Edit and Settings, cards (or Edit mode's
     list) and a floating toolbar of provider tabs, all Material Components views (ExpressiveDashboard
     fills it). Pull down to refresh. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/expressive_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <dev.bennett.codexmeter.ExpressivePull
        android:id="@+id/expressive_pull"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/expressive_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="128dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expressive_edit"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/expressive_edit"
                    app:icon="@drawable/ic_m3_edit" />

                <!-- Edit mode's Done: a filled button in place of Edit and Settings. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expressive_done"
                    style="@style/Widget.Material3Expressive.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/expressive_done"
                    android:visibility="gone"
                    app:icon="@drawable/ic_m3_check" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expressive_settings"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Settings"
                    app:icon="@drawable/ic_m3_settings" />
            </LinearLayout>

            <TextView
                android:id="@+id/expressive_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:textAppearance="?attr/textAppearanceDisplayMediumEmphasized"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:id="@+id/expressive_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Edit mode: the tab's cards or sections, each with a switch and a drag handle. -->
            <LinearLayout
                android:id="@+id/expressive_edit_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

        <!-- Pull to refresh (and any refresh): Expressive's contained loading indicator. -->
        <com.google.android.material.loadingindicator.LoadingIndicator
            android:id="@+id/expressive_loading"
            style="@style/Widget.Material3.LoadingIndicator.Contained"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:contentDescription="Refreshing"
            android:visibility="invisible" />
    </dev.bennett.codexmeter.ExpressivePull>

    <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
        android:id="@+id/expressive_toolbar"
        style="@style/Widget.Material3.FloatingToolbar.Vibrant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/expressive_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Providers"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>
</FrameLayout>
