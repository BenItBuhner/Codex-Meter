<?xml version="1.0" encoding="utf-8"?>
<!-- One UI 9 body for widget settings. Cancel / Save live in SESL9's floating bottom bar,
     which OneUi9Page adds over the page (oneui9_config_actions). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:id="@+id/widget_settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <dev.oneuiproject.oneui.widget.RoundedFrameLayout
            android:id="@+id/widget_preview_container"
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
