<?xml version="1.0" encoding="utf-8"?>
<!-- SESL9 floating Cancel / Save bar for widget settings (One UI 9 preview only). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
        android:id="@+id/design_config_floating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        app:enableScrollTransition="true"
        app:showFloatingItemBackground="true">

        <com.google.android.material.oneui.dividerbuttonlayout.DividerButtonLayout
            android:id="@+id/design_config_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:menu="@menu/design_config_actions" />
    </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
</FrameLayout>
