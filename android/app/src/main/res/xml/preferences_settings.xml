<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Accounts">
        <!-- Summaries for every row here are filled in by SettingsActivity. -->
        <Preference
            android:key="settings_providers"
            android:title="Providers &amp; accounts"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Live usage">
        <Preference
            android:key="settings_now_bar"
            android:title="Now Bar"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_notifications"
            android:title="Notifications"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_lock_widgets"
            android:title="Lock screen widgets"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Usage">
        <Preference
            android:key="settings_refresh_usage"
            android:title="Refresh &amp; dashboard"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_reset_credits"
            android:title="Reset credits"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_appearance"
            android:title="Appearance"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="App &amp; data">
        <Preference
            android:key="settings_updates"
            android:title="Updates"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_transfer"
            android:summary="Move settings between devices"
            android:title="Backup &amp; transfer"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_privacy"
            android:summary="Local storage, encryption, and network access"
            android:title="Privacy"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <dev.oneuiproject.oneui.preference.InsetPreferenceCategory app:height="20dp" />

    <Preference
        android:key="about_codex_meter"
        android:title="About Codex Meter"
        app:iconSpaceReserved="false" />

    <dev.oneuiproject.oneui.preference.InsetPreferenceCategory app:height="28dp" />
</PreferenceScreen>
