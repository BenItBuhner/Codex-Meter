<?xml version="1.0" encoding="utf-8"?>
<!-- The same top level on every platform: providers and their usage, alerts and live usage,
     then the app. Summaries for every row here are filled in by SettingsActivity. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Usage">
        <Preference
            android:key="settings_providers"
            android:title="Providers"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_refresh_usage"
            android:title="Dashboard"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_reset_credits"
            android:title="Reset credits"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Alerts &amp; live usage">
        <Preference
            android:key="settings_notifications"
            android:title="Notifications"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_now_bar"
            android:title="Live notification"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_lock_widgets"
            android:title="Lock screen widgets"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="App">
        <Preference
            android:key="settings_appearance"
            android:title="Appearance"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_updates"
            android:title="Updates"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="settings_privacy"
            android:summary="Backup, diagnostic logs and how your data is kept"
            android:title="Privacy &amp; data"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <dev.oneuiproject.oneui.preference.InsetPreferenceCategory app:height="20dp" />

    <Preference
        android:key="about_codex_meter"
        android:title="About Codex Meter"
        app:iconSpaceReserved="false" />

    <dev.oneuiproject.oneui.preference.InsetPreferenceCategory app:height="28dp" />
</PreferenceScreen>
