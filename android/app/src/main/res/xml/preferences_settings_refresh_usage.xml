<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Refresh">
        <!-- One list for both the mode and the manual interval; summary set in code. -->
        <ListPreference
            android:entries="@array/settings_refresh_combined_entries"
            android:entryValues="@array/settings_refresh_combined_values"
            android:key="refresh_schedule_ui"
            android:title="Refresh usage" />
        <SwitchPreferenceCompat
            android:key="refresh_on_launch"
            android:title="Refresh when opening the app" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Dashboard">
        <!-- Which cards appear, and their order, per dashboard tab. -->
        <Preference
            android:key="dashboard_reorder_ui"
            android:summary="Choose and arrange each tab's cards"
            android:title="Edit dashboard" />
        <SwitchPreferenceCompat
            android:key="usage_pace_enabled_ui"
            android:summary="How long your current allowance may last"
            android:title="Usage estimates" />
        <ListPreference
            android:entries="@array/usage_pace_sensitivity_entries"
            android:entryValues="@array/usage_pace_sensitivity_values"
            android:key="usage_pace_sensitivity_ui"
            android:title="Fast-usage warnings"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:key="model_speed_reference_ui"
            android:summary="On the Priority tab only when a Codex, Claude Code or Grok model runs much slower than usual, from public OpenRouter figures for each maker's newest models. Not your subscription's own speed."
            android:title="Model slowdown warnings" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="priority_category"
        android:title="Priority">
        <SwitchPreferenceCompat
            android:key="priority_view_ui"
            android:summary="A tab before your providers with everything that needs attention: limits running out and their pace, every other limit, official status, warnings and new models"
            android:title="Priority tab" />
        <EditTextPreference
            android:key="priority_name_ui"
            android:title="Your name for the greeting" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="priority_written_summary_ui"
            android:title="Written summary" />
        <Preference
            android:key="new_models_info_ui"
            android:selectable="false"
            android:summary="@string/new_models_refresh_note"
            android:title="New models"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

</PreferenceScreen>
