<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Theme">
        <dev.oneuiproject.oneui.preference.HorizontalRadioPreference
            android:key="app_theme"
            app:entries="@array/preferences_darkmode_entries"
            app:entriesImage="@array/preferences_darkmode_entries_image"
            app:entryValues="@array/preferences_darkmode_values"
            app:viewType="image" />
        <SwitchPreferenceCompat
            android:key="theme_system_ui"
            android:title="System default" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="material_you"
            android:summary="Use the system color palette when available"
            android:title="Material You" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Design">
        <ListPreference
            android:entries="@array/app_design_entries"
            android:entryValues="@array/app_design_values"
            android:key="app_design_ui"
            android:persistent="false"
            android:title="App design" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="glass_look_category"
        android:title="Liquid Glass">
        <SeekBarPreference
            android:defaultValue="25"
            android:key="glass_tint_level"
            android:max="100"
            android:title="Glass tint"
            app:min="0"
            app:showSeekBarValue="false"
            app:updatesContinuously="true" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="glass_reduce_transparency"
            android:summary="Draws the glass as a nearly solid fill"
            android:title="Reduce transparency" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="glass_increase_contrast"
            android:summary="Darker edges and a stronger tint behind text and controls"
            android:title="Increase contrast" />
    </PreferenceCategory>

</PreferenceScreen>
