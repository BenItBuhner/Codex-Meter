<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Theme">
        <dev.oneuiproject.oneui.preference.HorizontalRadioPreference
            android:key="app_theme"
            app:entries="@array/preferences_darkmode_entries"
            app:entriesImage="@array/preferences_darkmode_entries_image"
            app:entryValues="@array/preferences_darkmode_values"
            app:viewType="image" />
        <SwitchPreferenceCompat
            android:key="theme_system_ui"
            android:title="System default" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="material_you"
            android:summary="Use the system color palette when available"
            android:title="Material You" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Design">
        <ListPreference
            android:entries="@array/app_design_entries"
            android:entryValues="@array/app_design_values"
            android:key="app_design_ui"
            android:persistent="false"
            android:title="App design" />
        <ListPreference
            android:entries="@array/haptics_entries"
            android:entryValues="@array/haptics_values"
            android:key="haptics"
            android:persistent="false"
            android:title="Haptics"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="glass_look_category"
        android:title="Liquid Glass">
        <SeekBarPreference
            android:defaultValue="25"
            android:key="glass_tint_level"
            android:max="100"
            android:title="Glass tint"
            app:min="0"
            app:showSeekBarValue="false"
            app:updatesContinuously="true" />
        <ListPreference
            android:defaultValue="wide"
            android:entries="@array/glass_duo_entries"
            android:entryValues="@array/glass_duo_values"
            android:key="glass_duo_mode"
            android:persistent="false"
            android:summary="Back, the toolbar and the tabs move to a column on the right edge"
            android:title="Duo layout" />
    </PreferenceCategory>

</PreferenceScreen>
