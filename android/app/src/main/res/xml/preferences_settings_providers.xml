<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Show on the dashboard">
        <SwitchPreferenceCompat
            android:icon="@drawable/ic_provider_codex"
            android:key="provider_enabled_codex"
            android:persistent="false"
            android:title="@string/provider_codex" />
        <SwitchPreferenceCompat
            android:icon="@drawable/ic_provider_claude_code"
            android:key="provider_enabled_claude_code"
            android:persistent="false"
            android:title="@string/provider_claude_code" />
        <SwitchPreferenceCompat
            android:icon="@drawable/ic_provider_cursor"
            android:key="provider_enabled_cursor"
            android:persistent="false"
            android:title="@string/provider_cursor" />
    </PreferenceCategory>

    <Preference
        android:key="providers_footer"
        android:selectable="false"
        android:summary="With two or more providers on, tabs at the bottom of the dashboard switch between them. With one on, the tabs are hidden. At least one provider stays on."
        app:iconSpaceReserved="false" />

</PreferenceScreen>
