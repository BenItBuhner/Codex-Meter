{
  "description": "Shared Scheduled reset trigger/guard cases. Android (ParserSelfTest.testScheduledReset) and iOS (CodexMeterCore tests) build the same inputs and must reach the same outcome. Times are relative to `now`: window `reset_in_minutes` and schedule `fire_in_minutes` may be negative (already passed); `fetched_ago_seconds` ages the snapshot. Windows: five_hour = 18000 s, weekly = 604800 s, monthly = 2592000 s. `credits` -1 means unknown. Guard order: no credit, natural reset imminent (default 15 min, inclusive), nothing to reset (date/time only), date/time condition. A threshold trigger watches its own window; a date/time trigger skips for an imminent reset only when every used window resets within the horizon, because one credit clears them all.",
  "now": 1800000000000,
  "cases": [
    {"name": "five-hour threshold not reached waits",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"five_hour": {"used": 80, "reset_in_minutes": 120}, "weekly": {"used": 40, "reset_in_minutes": 3000}},
     "credits": 2, "expect": "wait"},
    {"name": "five-hour threshold reached exactly fires",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"five_hour": {"used": 95, "reset_in_minutes": 120}, "weekly": {"used": 40, "reset_in_minutes": 3000}},
     "credits": 2, "expect": "fire", "window": "5-hour", "remaining": 5},
    {"name": "five-hour threshold crossed fires",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"five_hour": {"used": 98, "reset_in_minutes": 120}, "weekly": {"used": 40, "reset_in_minutes": 3000}},
     "credits": 1, "expect": "fire", "window": "5-hour", "remaining": 2},
    {"name": "zero threshold needs a fully used window",
     "schedule": {"trigger": "five_hour", "threshold_percent": 0},
     "snapshot": {"five_hour": {"used": 99, "reset_in_minutes": 120}},
     "credits": 2, "expect": "wait"},
    {"name": "zero threshold fires at 100 percent used",
     "schedule": {"trigger": "five_hour", "threshold_percent": 0},
     "snapshot": {"five_hour": {"used": 100, "reset_in_minutes": 120}},
     "credits": 2, "expect": "fire", "remaining": 0},
    {"name": "threshold reached without credits skips",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"five_hour": {"used": 96, "reset_in_minutes": 120}},
     "credits": 0, "expect": "skip_no_credit"},
    {"name": "threshold reached with unknown credits fires and lets the consume path report",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"five_hour": {"used": 96, "reset_in_minutes": 120}},
     "credits": -1, "expect": "fire"},
    {"name": "threshold reached but natural reset in 10 minutes skips",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"five_hour": {"used": 96, "reset_in_minutes": 10}, "weekly": {"used": 40, "reset_in_minutes": 3000}},
     "credits": 2, "expect": "skip_reset_imminent", "window": "5-hour", "natural_reset_in_minutes": 10},
    {"name": "natural reset exactly 15 minutes out is still imminent",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"five_hour": {"used": 96, "reset_in_minutes": 15}},
     "credits": 2, "expect": "skip_reset_imminent", "natural_reset_in_minutes": 15},
    {"name": "natural reset 16 minutes out fires",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"five_hour": {"used": 96, "reset_in_minutes": 16}},
     "credits": 2, "expect": "fire"},
    {"name": "weekly threshold reached fires even when five-hour is healthy",
     "schedule": {"trigger": "weekly", "threshold_percent": 10},
     "snapshot": {"five_hour": {"used": 20, "reset_in_minutes": 120}, "weekly": {"used": 92, "reset_in_minutes": 3000}},
     "credits": 2, "expect": "fire", "window": "weekly", "remaining": 8},
    {"name": "weekly threshold follows the monthly window on the free tier",
     "schedule": {"trigger": "weekly", "threshold_percent": 10},
     "snapshot": {"monthly": {"used": 93, "reset_in_minutes": 20000}},
     "credits": 1, "expect": "fire", "window": "monthly", "remaining": 7},
    {"name": "threshold with its window missing waits",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"weekly": {"used": 96, "reset_in_minutes": 3000}},
     "credits": 2, "expect": "wait"},
    {"name": "threshold reached on a stale snapshot waits for fresh data",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"five_hour": {"used": 96, "reset_in_minutes": 120}, "fetched_ago_seconds": 300},
     "credits": 2, "expect": "wait"},
    {"name": "threshold window that already reset per its timeline waits",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": {"five_hour": {"used": 96, "reset_in_minutes": -5}},
     "credits": 2, "expect": "wait"},
    {"name": "threshold without a snapshot waits",
     "schedule": {"trigger": "five_hour", "threshold_percent": 5},
     "snapshot": null,
     "credits": 2, "expect": "wait"},
    {"name": "date-time before its time waits",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 30},
     "snapshot": {"five_hour": {"used": 80, "reset_in_minutes": 120}, "weekly": {"used": 40, "reset_in_minutes": 3000}},
     "credits": 2, "expect": "wait"},
    {"name": "date-time due with used windows fires",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0},
     "snapshot": {"five_hour": {"used": 38, "reset_in_minutes": 137}, "weekly": {"used": 64, "reset_in_minutes": 4800}},
     "credits": 2, "expect": "fire", "remaining": 36},
    {"name": "date-time three hours late still fires",
     "schedule": {"trigger": "date_time", "fire_in_minutes": -180},
     "snapshot": {"five_hour": {"used": 38, "reset_in_minutes": 137}, "weekly": {"used": 64, "reset_in_minutes": 4800}},
     "credits": 2, "expect": "fire"},
    {"name": "date-time due without credits skips",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0},
     "snapshot": {"five_hour": {"used": 38, "reset_in_minutes": 137}, "weekly": {"used": 64, "reset_in_minutes": 4800}},
     "credits": 0, "expect": "skip_no_credit"},
    {"name": "date-time due without a snapshot waits for a refresh",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0},
     "snapshot": null,
     "credits": 2, "expect": "wait"},
    {"name": "date-time due on a stale snapshot waits for a refresh",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0},
     "snapshot": {"five_hour": {"used": 38, "reset_in_minutes": 137}, "fetched_ago_seconds": 200},
     "credits": 2, "expect": "wait"},
    {"name": "date-time due with five-hour imminent but weekly used fires",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0},
     "snapshot": {"five_hour": {"used": 38, "reset_in_minutes": 5}, "weekly": {"used": 64, "reset_in_minutes": 4800}},
     "credits": 2, "expect": "fire"},
    {"name": "date-time due with the only used window imminent skips",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0},
     "snapshot": {"five_hour": {"used": 38, "reset_in_minutes": 12}, "weekly": {"used": 0, "reset_in_minutes": 4800}},
     "credits": 2, "expect": "skip_reset_imminent", "window": "5-hour", "natural_reset_in_minutes": 12},
    {"name": "date-time due with only weekly used and imminent skips on weekly",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0},
     "snapshot": {"five_hour": {"used": 0, "reset_in_minutes": 120}, "weekly": {"used": 64, "reset_in_minutes": 10}},
     "credits": 2, "expect": "skip_reset_imminent", "window": "weekly", "natural_reset_in_minutes": 10},
    {"name": "date-time due with both windows imminent skips",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0},
     "snapshot": {"five_hour": {"used": 38, "reset_in_minutes": 5}, "weekly": {"used": 64, "reset_in_minutes": 14}},
     "credits": 2, "expect": "skip_reset_imminent", "window": "5-hour"},
    {"name": "date-time due with nothing used skips",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0},
     "snapshot": {"five_hour": {"used": 0, "reset_in_minutes": 120}, "weekly": {"used": 0, "reset_in_minutes": 4800}},
     "credits": 2, "expect": "skip_nothing_to_reset"},
    {"name": "date-time condition above the lowest remaining skips",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0, "condition_percent": 10},
     "snapshot": {"five_hour": {"used": 38, "reset_in_minutes": 137}, "weekly": {"used": 64, "reset_in_minutes": 4800}},
     "credits": 2, "expect": "skip_condition_not_met", "remaining": 36},
    {"name": "date-time condition met by the five-hour window fires",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0, "condition_percent": 10},
     "snapshot": {"five_hour": {"used": 92, "reset_in_minutes": 137}, "weekly": {"used": 40, "reset_in_minutes": 4800}},
     "credits": 2, "expect": "fire", "remaining": 8},
    {"name": "date-time condition met by the weekly window fires",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0, "condition_percent": 10},
     "snapshot": {"five_hour": {"used": 40, "reset_in_minutes": 137}, "weekly": {"used": 90, "reset_in_minutes": 4800}},
     "credits": 2, "expect": "fire", "remaining": 10},
    {"name": "date-time condition unmet and no credits reports the missing credit first",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0, "condition_percent": 10},
     "snapshot": {"five_hour": {"used": 38, "reset_in_minutes": 137}},
     "credits": 0, "expect": "skip_no_credit"},
    {"name": "date-time condition unmet and reset imminent reports the imminent reset first",
     "schedule": {"trigger": "date_time", "fire_in_minutes": 0, "condition_percent": 10},
     "snapshot": {"five_hour": {"used": 38, "reset_in_minutes": 5}},
     "credits": 2, "expect": "skip_reset_imminent", "window": "5-hour"}
  ]
}
